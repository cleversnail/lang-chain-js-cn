# ================================================================
#  LangChain.js 中文电子书 —— 环境变量模板
#  用法：复制本文件为 .env，然后填入你自己的密钥
#      cp .env.example .env
# ================================================================

# ---- 对话模型（必填）----
# 只要你的服务商兼容 OpenAI 接口（/chat/completions），都可以直接用
AI_API_KEY=sk-你的密钥
AI_ENDPOINT=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ---- 嵌入模型（第 07、08 章需要）----
# DeepSeek 不提供 embedding 接口，请换成支持 embedding 的服务商
# 例如：硅基流动 https://api.siliconflow.cn/v1  +  BAAI/bge-m3
#      DashScope https://dashscope.aliyuncs.com/compatible-mode/v1 + text-embedding-v3
AI_EMBEDDING_MODEL=BAAI/bge-m3

# 如果嵌入服务与对话服务不是同一家，单独填写下面两项；
# 留空则回退使用上面的 AI_ENDPOINT / AI_API_KEY。
# 若无法提供 embedding，第 07/08 章会自动使用"本地离线嵌入"演示流程。
AI_EMBEDDING_ENDPOINT=
AI_EMBEDDING_API_KEY=

# ---- MCP（第 06 章，可选）----
# Context7 文档服务，免费无 Key 也能用（限速），填 Key 可提高额度
CONTEXT7_API_KEY=
