    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.0.0",
    "langchain": "^1.0.0",
    "mathjs": "^15.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4"
