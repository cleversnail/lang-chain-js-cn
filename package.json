{
  "name": "langchainjs-zh",
  "version": "1.0.0",
  "private": true,
  "description": "《LangChain.js 中文入门电子书》—— 基于 microsoft/langchainjs-for-beginners 整理，每章含中文讲解与可运行代码",
  "type": "module",
