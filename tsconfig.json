{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/**/*.ts",
    "0*-*/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "myAgent",
    ".source-reference"
  ]
}
